--- !u!114 &5078820869251858403
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5040159680206524243}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In the ethereal forests of Alfheim, the nameless being encounters a tribe
    of elven artisans struggling to rebuild their homes after the devastation of
    Ragnarok. Inspired by their determination, the being learns to harness the power
    of nature, weaving together vines and branches to create structures that blend
    seamlessly with the forest. With each dwelling they construct, they feel a deeper
    connection to the natural world, their ability to shape living elements becoming
    an integral part of their arsenal.\r\n\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 81cc66dda6eef5e4d9c0a1dec8c47766, type: 2}
  m_sharedMaterial: {fileID: 4928202655278997800, guid: 81cc66dda6eef5e4d9c0a1dec8c47766, type: 2}
