--- !u!114 &8563521139915139361
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7817791179389410522}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Journeying to the bustling cities of Midgard, the nameless being witnesses
    the resilience of mortal races as they strive to reclaim their civilization from
    the ashes of Ragnarok. Moved by their ingenuity, they delve into the mysteries
    of fire, mastering the art of forging metal and stone with the heat of their
    inner flames. Guided by skilled craftsmen, they learn to sculpt towering monuments
    and intricate designs, their creations standing as testaments to the indomitable
    spirit of humanity.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 81cc66dda6eef5e4d9c0a1dec8c47766, type: 2}
  m_sharedMaterial: {fileID: 4928202655278997800, guid: 81cc66dda6eef5e4d9c0a1dec8c47766, type: 2}
