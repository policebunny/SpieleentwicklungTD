  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Niflheim, one of the Nine Worlds, is a realm of ice, mist, and cold. It
    is home to the primordial well Hvergelmir, from which all rivers flow.

    Ruled
    by the dragon Nidhogg, Niflheim represents darkness and desolation. This realm
    is often contrasted with the fiery Muspelheim, embodying the balance of elemental
    forces.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 81cc66dda6eef5e4d9c0a1dec8c47766, type: 2}
